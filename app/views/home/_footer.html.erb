<footer class="p-4 bg-white border-t border-gray-200">
  <div class="max-w-4xl mx-auto" data-controller="comment-form" data-action="comment:edit@window->comment-form#fill">

    <!-- Edit mode panel -->
    <div data-comment-form-target="editPanel"
      class="hidden bg-blue-50 border-l-4 border-blue-500 p-2.5 rounded-t-xl mb-1 flex items-center justify-between text-xs text-blue-800"
    >
      <div class="flex items-center gap-2 truncate">
        <svg class="w-4 h-4 text-blue-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>

        <span class="truncate">
          Editing a comment:
          <span class="italic" data-comment-form-target="editText"></span>
        </span>
      </div>

      <button type="button" class="text-gray-400 hover:text-gray-600 font-bold px-2"
              data-action="click->comment-form#cancelEdit">
        ✕
      </button>
    </div>

    <!-- Submission form -->
    <%= form_with model: @comment, data: { comment_form_target: "form" },
                  class: "flex items-end gap-2 bg-gray-100 rounded-2xl p-2 border border-gray-200" do |f| %>

      <%= f.text_area :body, rows: 1, placeholder: "Write a comment...",
                      data: { comment_form_target: "input" },
                      class: "flex-1 bg-transparent resize-none border-0 focus:ring-0 text-sm outline-none pl-2 text-gray-800 py-1" %>

      <%= f.submit (@comment.new_record? ? "Send" : "Update"),
                   data: { comment_form_target: "submit" },
                   class: "bg-blue-600 text-white p-2.5 rounded-xl hover:bg-blue-700 transition" %>
    <% end %>

  </div>
</footer>
