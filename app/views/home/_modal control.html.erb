<div x-show="activeCommentMenu" class="fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center z-50 animate-fadeIn" @click.self="activeCommentMenu = null">
  <div class="bg-white rounded-2xl shadow-2xl p-5 max-w-sm w-full mx-4 border border-gray-100">
    <h3 class="font-bold text-gray-800 text-base mb-2">Comment management</h3>
    <p class="text-xs text-gray-500 mb-4 bg-gray-50 p-3 rounded-xl border border-gray-100 max-h-24 overflow-y-auto italic" x-text="activeCommentMenu?.body"></p>

    <div class="space-y-2">
      <!-- Available to everyone if it's their comment -->
      <template x-if="canModify(activeCommentMenu)">
        <div class="space-y-2">
          <button @click="startEdit(activeCommentMenu)" class="w-full bg-blue-50 text-blue-600 hover:bg-blue-100 font-semibold py-2.5 px-4 rounded-xl text-sm transition text-left flex items-center gap-2">
            ✏️ Edit comment
          </button>
          <button @click="deleteComment(activeCommentMenu)" class="w-full bg-red-50 text-red-600 hover:bg-red-100 font-semibold py-2.5 px-4 rounded-xl text-sm transition text-left flex items-center gap-2">
            🗑️ Delete comment
          </button>
        </div>
      </template>

      <template x-if="!canModify(activeCommentMenu)">
        <p class="text-xs text-red-500 bg-red-50 p-2 rounded-lg text-center font-medium">
          🔒 You can only edit or delete your own comments!
        </p>
      </template>

      <button @click="activeCommentMenu = null" class="w-full bg-gray-100 text-gray-700 hover:bg-gray-200 font-medium py-2 px-4 rounded-xl text-sm transition mt-2">
        Cancel
      </button>
    </div>
  </div>
</div>
