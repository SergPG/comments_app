<header class="h-16 border-b border-gray-200 bg-white px-6 flex items-center justify-between shadow-sm z-10">

  <div class="w-full max-w-md relative">
    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
    </span>
    <%= form_with url: root_path, method: :get, data: { turbo_frame: "comments_stream" },
                                                      class: "w-full max-w-md relative" do %>

      <!-- icon -->
      <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </span>

      <!-- input -->
      <%= text_field_tag :q,
                         params[:q],
                         placeholder: "Quick search by comment text...",
                         class: "w-full pl-10 pr-24 py-2 bg-gray-100 border border-gray-200 rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
      %>

      <!-- submit button (NEW) -->
      <button type="submit"
              class="absolute inset-y-0 right-10 flex items-center text-xs font-semibold text-blue-600 hover:text-blue-800">
        Search
      </button>
    <% end %>
  </div>

  <!-- Notifications Dropdown -->
  <div class="relative ml-4">
    <button class="relative p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-full transition">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <!-- Unread counter -->
      <span class="absolute top-1 right-1 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center animate-bounce">
        1
      </span>
    </button>

    <!-- Notification pop-up window -->
    <div class="absolute right-0 mt-2 w-80 bg-white border border-gray-200 rounded-2xl shadow-xl overflow-hidden z-50">
      <div class="p-3 bg-gray-50 border-b border-gray-100 flex items-center justify-between">
        <span class="font-bold text-sm text-gray-700">
          Notification
        </span>
        <button class="text-xs text-blue-600 hover:underline">Read all</button>
      </div>
      <div class="max-h-64 overflow-y-auto divide-y divide-gray-100">
        <template>
          <div class="p-3 transition hover:bg-gray-50 flex items-start gap-2.5" :class="!notif.read ? 'bg-blue-50/50' : ''">
            <div class="w-2 h-2 mt-1.5 rounded-full bg-blue-500 flex-shrink-0" x-show="!notif.read"></div>
            <div class="flex-1 min-w-0">
              <p class="text-xs text-gray-700" :class="!notif.read ? 'font-semibold' : ''" x-text="notif.text"></p>
              <span class="text-[10px] text-gray-400 mt-1 block">
                11:00
              </span>
            </div>
            <button class="text-xs text-gray-400 hover:text-blue-600 p-0.5">
              ✓
            </button>
          </div>
        </template>
        <div class="p-4 text-center text-sm text-gray-400">
          No new notifications
        </div>
      </div>
    </div>
  </div>

</header>
