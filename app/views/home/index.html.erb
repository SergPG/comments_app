<%= render partial: "sidebar" %>

<main class="flex-1 flex flex-col bg-[#f4f4f5] relative" data-controller="comments">

  <%= render partial: "header" %>

  <!-- Comments Stream -->
  <div class="flex-1 overflow-y-auto p-4" id="comments">
    <turbo-frame id="comments_stream">
      <%= render partial: "stream" %>
    </turbo-frame>
  </div>

  <!-- Footer: Entering comment text (or editing mode) -->
  <%= render partial: "footer" %>

  <!-- Modal window -->
  <%= render partial: "modal_control" %>

</main>
