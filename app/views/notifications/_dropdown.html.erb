<div data-dropdown-target="menu"
     class="hidden absolute right-0 mt-2 w-80 bg-white border border-gray-200 rounded-2xl shadow-xl overflow-hidden z-50">

  <div class="p-3 bg-gray-50 border-b flex justify-between" data-dropdown-ignore>
    <span class="font-bold text-sm">Notifications</span>
    <%= link_to "Read all", "#" , class: "text-xs text-blue-600 hover:underline" %>
  </div>

  <div class="max-h-64 overflow-y-auto divide-y divide-gray-100">

    <%= render @notifications %>

    <% if @notifications.empty? %>
      <div class="p-4 text-center text-sm text-gray-400">
        No new notifications
      </div>
    <% end %>

  </div>
</div>
