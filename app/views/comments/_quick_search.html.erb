<div class="w-full max-w-md relative">
    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
    </span>
  <%= form_with url: root_path, method: :get, data: { turbo_frame: "comments_stream" },
                class: "w-full max-w-md relative" do %>

    <!-- icon -->
    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </span>

    <!-- input -->
    <%= text_field_tag :q,
                       params[:q],
                       placeholder: "Quick search by comment text...",
                       class: "w-full pl-10 pr-24 py-2 bg-gray-100 border border-gray-200 rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
    %>

    <!-- submit button -->
    <button type="submit"
            class="absolute inset-y-0 right-10 flex items-center text-xs font-semibold text-blue-600 hover:text-blue-800">
      Search
    </button>
  <% end %>
</div>
