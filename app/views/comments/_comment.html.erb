<div id="<%= dom_id(comment) %>"
     class="flex items-start gap-3 px-3 py-2 bg-white rounded-xl shadow-sm hover:shadow-md transition"
     data-action="click->comments#open"
     data-comment="<%= comment.to_json(only: [:id, :body, :user_id]) %>">

  <!-- Avatar -->
  <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center text-white text-xs shrink-0">
    <%= comment.user.username.first.upcase %>
  </div>

  <!-- Content -->
  <div class="flex-1">

    <!-- Header -->
    <div class="flex items-center gap-2 text-xs text-gray-500">
      <span class="font-semibold text-gray-800">
        <%= comment.user.username %>
      </span>

      <span>•</span>

      <span>
        <%= time_ago_in_words(comment.created_at) %> ago
      </span>
    </div>

    <!-- Body -->
    <div class="text-sm text-gray-900 leading-snug whitespace-pre-wrap">
      <%= comment.body %>
    </div>

  </div>
</div>
